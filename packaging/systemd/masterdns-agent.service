[Unit]
Description=MasterDNS external health probe agent
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=masterdns-agent
Group=masterdns-agent
ExecStart=/usr/local/bin/masterdns-agent run --config /etc/masterdns-agent/config.json
Restart=on-failure
RestartPreventExitStatus=3
RestartSec=5s
TimeoutStartSec=15s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/masterdns-agent
CapabilityBoundingSet=
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
